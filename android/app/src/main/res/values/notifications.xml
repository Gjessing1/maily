<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification presentation for the one channel Maily registers.

  Maily posts its own notifications — MailyPushNotifier builds them from the answer to
  its background poll — so these are read by app code rather than by any push SDK's
  manifest meta-data.

  The channel is created by MailyPushNotifier.ensureChannels before anything is posted:
  Android 8+ silently drops a notification whose channel id was never registered.

  There used to be a second, deliberately silenced "Connection" channel carrying the
  ongoing notice Android demands of a long-running foreground service. Maily no longer
  runs one (MailyPushAlarm), so those ids are retired below and deleted on startup — a
  channel outlives the code that created it, and an abandoned one just sits in the
  system's notification settings attached to nothing.
-->
<resources>
    <!-- Matches the web app's dark-theme accent token (frontend/src/index.css). -->
    <color name="maily_accent">#6d6bff</color>
    <string name="mail_notification_channel_id" translatable="false">maily-mail</string>
    <string name="mail_notification_channel_name">New mail</string>
    <string name="mail_notification_channel_description">Notifications for mail arriving in your inbox.</string>
    <!-- Channels Maily no longer posts on. Order is irrelevant; add an id here whenever
         one is abandoned, and never reuse it for something else. -->
    <string-array name="retired_notification_channel_ids" translatable="false">
        <item>maily-connection</item>
        <item>maily-connection-silent</item>
    </string-array>
</resources>
